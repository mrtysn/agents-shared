#!/bin/zsh
# DESC: git pre-push hook — scan a public repo's push for denylisted names, skip private repos, then run the repo's own pre-push
#
# Safe to set globally (`git config --global core.hooksPath "$AGENTS_SHARED/githooks"`):
#   1. Visibility first. For a github.com remote it asks `gh api repos/OWNER/NAME --jq .private`
#      and caches the answer (private or public) per repo for 7 days under
#      ${XDG_CACHE_HOME:-~/.cache}/agents-shared/repo-visibility/. A private repo passes
#      unscanned. A public one is scanned by githooks/scan-push-names (see its header for what
#      is read and for the denylist). Unknown (gh missing, offline, an API error, a remote that
#      is not github.com) is scanned, with one line saying why: unknown never passes silently.
#      A repo flipped from private to public stays "private" in the cache for up to 7 days;
#      delete the repo's file in the cache folder to force a fresh look.
#   2. The repo's own hook. A core.hooksPath makes git ignore .git/hooks/, where git-lfs installs
#      its pre-push; so after a passing scan this runs $(git rev-parse --git-common-dir)/hooks/pre-push,
#      if executable, with the same arguments and stdin, and exits non-zero when it does. The other
#      client-side hooks are symlinks to chain-hook, which does the same for them.
#
# The missing-denylist refusal belongs to the scan, so it applies only to pushes that are scanned.
# `git push --no-verify` skips it, as it skips every git hook.
#
# usage (by git): pre-push <remote-name> <remote-url>, refs on stdin as
#     <local-ref> <local-sha> <remote-ref> <remote-sha>
set -uo pipefail
setopt extendedglob

dir=${0:A:h}
url=${2:-}
tmp=$(mktemp -d) || exit 1
trap 'rm -rf -- "$tmp"' EXIT
cat > $tmp/stdin   # both the scan and the repo's own hook read the refs

# visibility <url>: print private, public or unknown.
visibility() {
  local u=${1%/} rest owner name cache file out
  case $u in
    https://github.com/*|http://github.com/*) rest=${u#*://github.com/} ;;
    https://*@github.com/*) rest=${u#*@github.com/} ;;
    git@github.com:*) rest=${u#git@github.com:} ;;
    ssh://git@github.com/*) rest=${u#ssh://git@github.com/} ;;
    git://github.com/*) rest=${u#git://github.com/} ;;
    *) print unknown; return ;;
  esac
  rest=${rest%.git}
  owner=${rest%%/*} name=${rest#*/}
  if [[ -z $owner || -z $name || $name == */* || $owner == $rest || $rest != [A-Za-z0-9._/-]## ]]; then print unknown; return; fi
  cache=${XDG_CACHE_HOME:-$HOME/.cache}/agents-shared/repo-visibility
  file=$cache/${(L)owner}__${(L)name}
  if [[ -n $(find $cache -maxdepth 1 -type f -name ${file:t} -mtime -7 2>/dev/null) ]]; then   # a fresh answer: under 7 days old
    out=$(<$file)
    [[ $out == (private|public) ]] && { print $out; return; }
  fi
  command -v gh >/dev/null 2>&1 || { print unknown; return; }
  out=$(GH_PROMPT_DISABLED=1 gh api "repos/$owner/$name" --jq .private 2>/dev/null) || { print unknown; return; }
  case $out in
    true)  out=private ;;
    false) out=public ;;
    *) print unknown; return ;;
  esac
  mkdir -p $cache 2>/dev/null && print -r -- $out > $file 2>/dev/null
  print $out
}

scan=1
vis=$(visibility $url)
case $vis in
  private) scan=0 ;;
  public) ;;
  *) print -u2 -r -- "pre-push: visibility of ${url:-the remote} is unknown (not a github.com remote, or gh is missing, offline or refused), so the push is scanned." ;;
esac

if (( scan )); then
  $dir/scan-push-names "$@" < $tmp/stdin || exit $?
fi

common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 0
own=$common/hooks/pre-push
if [[ -f $own && -x $own && ${own:A} != ${0:A} ]]; then
  $own "$@" < $tmp/stdin || exit $?
fi
exit 0
