# Jira board configuration — copy to `.env.jira` at the root of the repo you
# want a board for, then fill in. `.env.jira` is gitignored; this example is not.
#
#   cp .env.jira.example /path/to/your-repo/.env.jira
#
# jira-board.py walks up from the working directory to find the nearest
# .env.jira, so one file per repo lets different projects use different boards.
# Real environment variables take precedence over anything set here.

# --- Required ---------------------------------------------------------------

# The account the API token belongs to.
JIRA_EMAIL=you@example.com

# Create at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Your site's cloud id (a UUID, not the hostname). Find it by visiting:
#   https://<your-site>.atlassian.net/_edge/tenant_info
JIRA_CLOUD_ID=

# --- Optional ---------------------------------------------------------------

# Project key used when you don't pass -p. Without it, -p becomes required.
JIRA_DEFAULT_PROJECT=

# Board columns, in display order, comma-separated. These must match your
# workflow's status names exactly. Each gets its own colour automatically.
# Default: To Do, In Progress, In Review
JIRA_COLUMNS=

# Statuses counted as finished and folded off the board, comma-separated.
# Default: Done, Closed
JIRA_DONE_STATUSES=
