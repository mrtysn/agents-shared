{
  "kind": "symlinks-into-home",
  "name": "Agents shared",
  "tool": "agents-shared",
  "symlinks_into_home": {
    "links": [
      {
        "from": "claude/commands/*",
        "to": "~/.claude/commands/"
      },
      {
        "from": "claude/skills/*",
        "to": "~/.claude/skills/"
      },
      {
        "from": "claude/rules/*",
        "to": "~/.claude/rules/"
      }
    ],
    "install_command": [
      "bash",
      "scripts/init-global.sh"
    ]
  },
  "test": [
    {
      "name": "skills and rules",
      "run": [
        "scripts/check-skills.zsh"
      ]
    },
    {
      "name": "hook tests",
      "run": [
        "bash",
        "-c",
        "for t in block-adb-server-kill end-turn-for-queued-slash-command memory-lint nudge-named-skills-and-stale-shells nudge-transcript-parsers refuse-requested-content-before-tool-call require-absolute-rm require-question-facts-in-question require-subagent-sizing require-user-quote-before-session-message show-rule-at-action ssh-request-guard subagent-guard; do bash hooks/tests/run-$t.sh || exit 1; done"
      ]
    },
    {
      "name": "away hook tests",
      "run": [
        "hooks/tests/run-away-stretch.sh"
      ]
    },
    {
      "name": "transcript reader tests",
      "run": [
        "python3",
        "scripts/tests/test_transcript_items.py"
      ]
    },
    {
      "name": "why-question survey tests",
      "run": [
        "python3",
        "scripts/tests/test_find_why_question_answers.py"
      ]
    },
    {
      "name": "usage survey index tests",
      "run": [
        "python3",
        "scripts/tests/test_usage_survey_index.py"
      ]
    },
    {
      "name": "clo launch tests",
      "run": [
        "scripts/tests/test-clo-launch.zsh"
      ]
    },
    {
      "name": "external skill links",
      "run": [
        "bash",
        "scripts/sync-external-skills.sh",
        "--check-links"
      ]
    }
  ]
}
