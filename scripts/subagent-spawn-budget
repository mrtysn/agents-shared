#!/bin/zsh
# subagent-spawn-budget — the one reader and writer of the machine-local subagent spawn budget file,
# ${XDG_CONFIG_HOME:-~/.config}/agents-shared/subagent-spawn-budget (shape:
# scripts/subagent-spawn-budget.example). hooks/subagent-guard.sh reads it through the first form;
# CC Sessions' Guards menu lists and sets it through the other two, so the rules live only here.
#
#   subagent-spawn-budget [CONFIG_DIR]
#       The budget for the Claude account whose config folder is CONFIG_DIR (default:
#       ${CLAUDE_CONFIG_DIR:-~/.claude}): a number or "unlimited". Prints nothing when the file is
#       missing or has no line for that account, so the caller keeps its default.
#   subagent-spawn-budget --list
#       One line per row, tab-separated: NAME VALUE SOURCE, for * first and then each account in
#       claude-accounts. SOURCE is "own" (its own line), "all" (the * line) or "default" (no line;
#       VALUE is the hook's default, 8).
#   subagent-spawn-budget --set NAME VALUE
#       Sets the line for NAME (* or an account name) to VALUE (a number or unlimited), or removes
#       it when VALUE is empty. Every earlier line for NAME, a bad one included, is replaced by one
#       line where the first stood; other lines and comments are kept. Refuses a file it cannot read.
#
# The account name comes from the claude-accounts file beside it, matched by config folder; a
# folder in no account line is covered by * alone. Numbers are base 10 (08 is 8), at most 9 digits.
# Exit 0 on success; exit 2 on a bad line (with the file and line on stderr) or bad arguments.
emulate -L zsh
setopt extended_glob

# The hook's own default, shown by --list; hooks/subagent-guard.sh keeps BUDGET=8 to match.
DEFAULT_BUDGET=8

dir="${XDG_CONFIG_HOME:-$HOME/.config}/agents-shared"
file="$dir/subagent-spawn-budget"
accounts="$dir/claude-accounts"

die() { print -u2 -r -- "subagent-spawn-budget: $*"; exit 2; }

# account_rows: "NAME<TAB>FOLDER" per account in claude-accounts, in file order, FOLDER resolved.
account_rows() {
    [[ -r "$accounts" ]] || return 0
    local line name folder rest
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${${line%%\#*}//$'\r'/}"
        read -r name folder rest <<< "$line" || true
        [[ -n "$name" && -n "$folder" ]] || continue
        folder="${folder/#\~/$HOME}"; folder="${folder/#\$HOME/$HOME}"
        print -r -- "$name"$'\t'"${folder:A}"
    done < "$accounts"
}

# normalise VALUE: sets $normal to it in base 10 without leading zeros, or "unlimited"; returns 1
# when invalid, with the reason in $why. Called in this shell, never in $(…), so both survive.
typeset why="" normal=""
normalise() {
    local value="$1"
    [[ "$value" == (<->|unlimited) ]] || { why="needs a whole number or unlimited"; return 1; }
    [[ "$value" == unlimited ]] && { normal=unlimited; return 0; }
    value="${value##0##}"
    (( ${#value} <= 9 )) || { why="has more than 9 digits; write unlimited instead"; return 1; }
    normal="${value:-0}"
}

# read_file: fills `all` (the * line's value) and the associative array `budget` (account name ->
# value), the last line for a name winning. Exits 2 on the first bad line.
typeset -A budget
typeset all=""
read_file() {
    [[ -e "$file" ]] || return 0
    [[ -r "$file" ]] || die "$file cannot be read"
    local line key value
    local -i n=0
    local -a fields
    while IFS= read -r line || [[ -n "$line" ]]; do
        (( n++ ))
        line="${${line%%\#*}//$'\r'/}"
        fields=(${=line})
        (( ${#fields} )) || continue
        (( ${#fields} == 2 )) || die "$file line $n needs an account name or *, then a whole number or unlimited: $line"
        key="${fields[1]}"
        normalise "${fields[2]}" || die "$file line $n $why: $line"
        value="$normal"
        if [[ "$key" == "*" ]]; then all="$value"; else budget[$key]="$value"; fi
    done < "$file"
}

# value_for NAME: the line's own value for NAME (* or an account), or nothing.
value_for() {
    if [[ "$1" == "*" ]]; then print -r -- "$all"
    elif [[ -n "$1" ]]; then print -r -- "${budget[$1]:-}"
    fi
}

case "${1:-}" in
--list)
    (( $# == 1 )) || die "--list takes no arguments"
    read_file
    local_names=("*" ${(f)"$(account_rows | cut -f1)"})
    for name in "${local_names[@]}"; do
        own="$(value_for "$name")"
        if [[ -n "$own" ]]; then print -r -- "$name"$'\t'"$own"$'\t'own
        elif [[ -n "$all" ]]; then print -r -- "$name"$'\t'"$all"$'\t'all
        else print -r -- "$name"$'\t'"$DEFAULT_BUDGET"$'\t'default
        fi
    done
    ;;
--set)
    (( $# == 3 )) || die "--set takes NAME VALUE (VALUE empty to remove the line)"
    name="$2"
    [[ "$name" == "*" || "$name" == [^[:space:]\#]## ]] || die "not an account name: $name"
    value=""
    if [[ -n "$3" ]]; then normalise "${3:l}" || die "$3 $why"; value="$normal"; fi
    [[ ! -e "$file" || -r "$file" ]] || die "$file cannot be read, so it is left as it is"
    typeset -a rows
    if [[ -s "$file" ]]; then
        rows=("${(@f)$(<"$file")}")
    elif [[ -e "$file" ]]; then
        rows=()
    else
        rows=("# account   budget (shape: agents-shared/scripts/subagent-spawn-budget.example)")
    fi
    new="${(r:12:)name} $value"; [[ ${#name} -ge 12 ]] && new="$name $value"
    typeset -a out
    placed=0
    for row in "${rows[@]}"; do
        stripped="${${row%%\#*}//$'\r'/}"
        first="${${=stripped}[1]:-}"
        if [[ "$first" == "$name" ]]; then
            (( placed )) || { [[ -n "$value" ]] && out+=("$new"); placed=1; }
            continue
        fi
        out+=("$row")
    done
    (( placed )) || [[ -z "$value" ]] || out+=("$new")
    mkdir -p "$dir" || die "cannot make $dir"
    tmp="$(mktemp "$file.XXXXXX")" || die "cannot write beside $file"
    print -r -l -- "${out[@]}" > "$tmp" && mv -f "$tmp" "$file" || { rm -f "$tmp"; die "cannot write $file"; }
    ;;
--*)
    die "unknown option $1"
    ;;
*)
    (( $# <= 1 )) || die "takes at most one CONFIG_DIR"
    config="${1:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}}"
    config="${config:A}"
    read_file
    account="$(account_rows | awk -F'\t' -v c="$config" '$2 == c { print $1; exit }')"
    value="$(value_for "$account")"
    [[ -n "$value" ]] || value="$all"
    [[ -n "$value" ]] && print -r -- "$value"
    ;;
esac
exit 0
