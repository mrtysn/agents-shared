#!/bin/zsh
# DESC: Pick a folder, Claude model and effort from menus and launch Claude Code; model and effort open on your last pick
set -euo pipefail

usage() {
    cat <<'EOF'
clo — pick a folder, Claude model and effort level, then launch Claude Code.

Usage:
  clo [claude args...]    Open the picker; extra args go to `claude` (e.g. clo -c)
  clo --list              Print the menu entries and exit
  clo -h | --help         Show this help

Esc goes back to the previous menu (and quits from the first); Ctrl-C quits.

The picks apply to that session only (claude --model --effort); your saved
defaults in settings.json are untouched. The model menu opens on your last
model, and the effort menu on the effort you last used with that model.
"unset" passes no --effort, so Claude Code's own default applies.

Launched outside $DEV_ROOT, clo first asks where to launch: $DEV_ROOT itself,
the current folder ("here", where the cursor starts), or any folder
local-repos-list reports, with its tags. Folders you last used Claude in come
first, with how long ago. Inside $DEV_ROOT it launches in the current folder.

When the folder has a past session, clo asks whether to start a new one,
continue the most recent (claude --continue) or pick one (claude --resume).

The model menu is the stable aliases (always the latest of each family) plus any
extra models your account is offered, read from Claude Code's own cache in
.claude.json. Claude Code has no command that prints the picker's list.
EOF
}

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/clo"
claude_json="${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json"

# Model families, most capable first. An extra from the cache whose family is
# not listed here goes last.
families=(fable opus sonnet haiku)

# value <TAB> label, most capable first
menu() {
    local -a rows=($'opus\tOpus' $'sonnet\tSonnet' $'haiku\tHaiku')
    if [[ -r "$claude_json" ]] && command -v jq >/dev/null; then
        rows+=("${(@f)$(jq -r '.additionalModelOptionsCache[]? | [.value, .label] | @tsv' \
            "$claude_json" 2>/dev/null | grep -vE $'^(opus|sonnet|haiku)\t' || true)}")
    fi
    local row fam rank
    for row in "${rows[@]}"; do
        [[ -n "$row" ]] || continue
        rank=$(( ${#families} + 1 ))
        for fam in "${families[@]}"; do
            [[ "${row%%$'\t'*}" == *"$fam"* ]] && { rank=${families[(i)$fam]}; break; }
        done
        print -r -- "$rank"$'\t'"$row"
    done | sort -t$'\t' -k1,1n -s | cut -f2-
}

case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    --list)    menu | cut -f2; exit 0 ;;
esac

command -v fzf >/dev/null || { print -u2 "clo: fzf is not on PATH"; exit 1; }
command -v claude >/dev/null || { print -u2 "clo: claude is not on PATH"; exit 1; }

# pick <prompt> <state file> <first-run value> <value<TAB>[…<TAB>]label>... — print the
# chosen value. The menu opens on the value saved in <state file>, else on
# <first-run value>, else on the first entry. An empty <state file> remembers nothing.
# Returns 2 when Esc asks for the previous menu, 130 on Ctrl-C.
pick() {
    local prompt="$1" state="$2" last="$3"; shift 3
    local pos=1 i choice saved=""
    [[ -n "$state" && -r "$state" ]] && saved="$(<"$state")" && last="$saved"
    local -a rows=("$@")
    for i in {1..$#rows}; do
        [[ "${rows[$i]%%$'\t'*}" == "$last" ]] || continue
        pos=$i
        [[ -n "$saved" ]] && rows[$i]+=$'  \e[2mlatest\e[0m'
        break
    done
    set -- "${rows[@]}"
    choice="$(print -rl -- "$@" \
        | fzf --ansi --delimiter=$'\t' --with-nth=2.. --nth=-1 --height=~50% --reverse --info=hidden \
              --prompt="$prompt> " --bind="load:pos($pos)" --bind=change:first \
              --bind='esc:print(<back>)+accept')" \
        || [[ "$choice" == "<back>"* ]] || return 130
    [[ "${choice%%$'\n'*}" == "<back>" ]] && return 2
    choice="${choice%%$'\t'*}"
    if [[ -n "$state" ]]; then
        mkdir -p "${state:h}"
        print -r -- "$choice" > "$state"
    fi
    print -r -- "$choice"
}

zmodload -F zsh/stat b:zstat
zmodload zsh/datetime
projects_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects"
now=$EPOCHSECONDS

# last_session <dir> — print when Claude Code last wrote a session for <dir>
# (epoch seconds), or nothing. Its per-folder directory name is the real path
# with every character other than a letter or digit turned into "-".
last_session() {
    local -a f=("$projects_dir/${${1:A}//[^A-Za-z0-9]/-}"/*.jsonl(N.om[1]))
    (( $#f )) && zstat +mtime -- "$f[1]"
}

# ago <epoch> — "now", "5m", "3h", "12d", "4mo"
ago() {
    local s=$(( now - $1 ))
    if   (( s < 60 ));      then print -r -- now
    elif (( s < 3600 ));    then print -r -- "$(( s / 60 ))m"
    elif (( s < 86400 ));   then print -r -- "$(( s / 3600 ))h"
    elif (( s < 2592000 )); then print -r -- "$(( s / 86400 ))d"
    else                         print -r -- "$(( s / 2592000 ))mo"
    fi
}

# path <TAB> dimmed age + tags <TAB> name, for every folder local-repos-list reports,
# after rows for the dev root itself and the current folder ("here"). Falls back to the dev root's
# immediate subfolders, untagged, when local-repos-list is not installed.
folder_menu() {
    local dim=$'\e[2m' off=$'\e[0m' here="${PWD/#$HOME/~}"
    local -a names paths tags
    local name dir tag i
    if command -v local-repos-list >/dev/null && command -v jq >/dev/null; then
        while IFS=$'\t' read -r name dir tag; do
            names+=("$name") paths+=("$dir") tags+=("$tag")
        done < <(local-repos-list --root "$DEV_ROOT" --json 2>/dev/null \
            | jq -r 'sort_by(.name | ascii_downcase)[] | [.name, .path, (.tags | join(" "))] | @tsv')
    else
        for dir in "$DEV_ROOT"/*(N/); do
            names+=("${dir:t}") paths+=("$dir") tags+=("")
        done
    fi
    # Folders with a Claude session come first, most recent on top; the rest
    # keep alphabetical order. The dev root and "here" always lead.
    local -a when order
    for i in {1..$#names}; do when[$i]="$(last_session "${paths[$i]}")"; done
    order=(${(f)"$(for i in {1..$#names}; do print -r -- "${when[$i]:-0}"$'\t'"$i"; done \
        | sort -t$'\t' -k1,1nr -k2,2n | cut -f2)"})
    # Age and tags go first, padded to one width, so every name starts in the
    # same column however long it is; pick() searches only the last field.
    local tw=${#here} t
    for tag in "${tags[@]}"; do (( ${#tag} > tw )) && tw=${#tag}; done
    row() {
        t="$(last_session "$1")"; [[ -n "$t" ]] && t="$(ago "$t")"
        printf '%s\t%s%-4s %-*s%s  \t%s\n' "$1" "$dim" "$t" "$tw" "$3" "$off" "$2"
    }
    row "$DEV_ROOT" "${DEV_ROOT:t}" "${DEV_ROOT/#$HOME/~}"
    row "$PWD" here "$here"
    for i in "${order[@]}"; do row "${paths[$i]}" "${names[$i]}" "${tags[$i]}"; done
}

# The menus run as a wizard: folder (outside the dev root only), session (only
# when the folder has one), model, effort. Esc steps back to the previous menu
# that was shown, and quits from the first; Ctrl-C quits from any.
start="$PWD" ask_folder=0
if [[ -n "${DEV_ROOT:-}" && -d "$DEV_ROOT" ]]; then
    dev="${DEV_ROOT:A}"
    [[ "${PWD:A}" != "$dev" && "${PWD:A}" != "$dev"/* ]] && ask_folder=1
fi

step=1 shown=() launch=()
while (( step <= 4 )); do
    rc=0
    case $step in
    1)  # Where to launch.
        (( ask_folder )) || { step=2; continue; }
        cd "$start"
        dir="$(pick folder "" "$start" "${(@f)$(folder_menu)}")" || rc=$?
        (( rc )) || cd "$dir" ;;
    2)  # With a past session here: start fresh, continue the most recent one,
        # or open Claude Code's own session picker.
        launch=()
        t="$(last_session "$PWD" || true)"
        [[ -n "$t" ]] || { step=3; continue; }
        t="$(ago "$t")"; [[ "$t" == now ]] || t+=" ago"
        session="$(pick session "" new $'new\tnew' \
            "continue"$'\t'"continue  "$'\e[2m'"$t"$'\e[0m' \
            $'resume\tresume…')" || rc=$?
        case "$session" in
            continue) launch+=(--continue) ;;
            resume)   launch+=(--resume) ;;
        esac ;;
    3)  model="$(pick model "$state_dir/last" "" "${(@f)$(menu)}")" || rc=$? ;;
    4)  # Effort is remembered per model: medium on Opus and xhigh on Fable each stick.
        effort="$(pick effort "$state_dir/effort/${model//[^A-Za-z0-9._-]/_}" unset \
            $'unset\tunset' $'low\tlow' $'medium\tmedium' $'high\thigh' \
            $'xhigh\txhigh' $'max\tmax')" || rc=$? ;;
    esac
    case $rc in
        0) shown+=($step); step=$(( step + 1 )) ;;
        2) (( $#shown )) || exit 130
           step=${shown[-1]}; shown[-1]=() ;;
        *) exit 130 ;;
    esac
done

launch+=(--model "$model")
[[ "$effort" != unset ]] && launch+=(--effort "$effort")
exec claude "${launch[@]}" "$@"
