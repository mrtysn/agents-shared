#!/bin/zsh
# DESC: Pick a folder, Claude model and effort from menus and launch Claude Code; model and effort open on your last pick
set -euo pipefail

usage() {
    cat <<'EOF'
clo — pick a folder, Claude model and effort level, then launch Claude Code.

Usage:
  clo [claude args...]    Open the picker; extra args go to `claude` (e.g. clo --chrome)
  clo --list              Print the menu entries and exit
  clo --init zsh          Print the shell function that leaves your terminal in
                          the launched folder; add to .zshrc: eval "$(clo --init zsh)"
  clo -h | --help         Show this help

Enter or → picks; Esc or ← goes back to the previous menu (and quits from the
first); Ctrl-C quits. Ctrl-B and Ctrl-F move within what you typed.

The picks apply to that session only (claude --model --effort); your saved
defaults in settings.json are untouched. The model menu opens on your last
model, and the effort menu on the effort you last used with that model.
"unset" passes no --effort, so Claude Code's own default applies.

Launched outside $DEV_ROOT, clo first asks where to launch: $DEV_ROOT itself,
the current folder (shown as its path, where the cursor starts), or any folder
local-repos-list reports, with its tags. Folders you last used Claude in come
first, with how long ago. Inside $DEV_ROOT it launches in the current folder.

The model menu lists the models, each starting a new session, then the
folder's sessions from cc-statusline (the list Agent Bar Hopping shows), each
reopened with claude --resume <id>, then "resume a session" for Claude Code's
own picker. Reopening a session launches at once: it already has its model
and effort.

"search history", the top row of the first menu, searches every past session
in every folder as you type (search-history.py, beside clo, keeps an index in
~/.cache/search-history). A plain term matches anywhere, ignoring case; one
with regex characters is a regex. Each hit shows its age, folder, topic and
match count, and the side pane shows every match. Enter reopens it in its own
folder.

The model menu is the stable aliases (always the latest of each family) plus any
extra models your account is offered, read from Claude Code's own cache in
.claude.json. Claude Code has no command that prints the picker's list.
EOF
}

self="${0:A}"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/clo"
claude_json="${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json"

# Model families, most capable first. An extra from the cache whose family is
# not listed here goes last.
families=(fable opus sonnet haiku)

# value <TAB> label, most capable first
menu() {
    local -a rows=($'opus\tOpus' $'sonnet\tSonnet' $'haiku\tHaiku')
    if [[ -r "$claude_json" ]] && command -v jq >/dev/null; then
        rows+=("${(@f)$(jq -r '.additionalModelOptionsCache[]? | [.value, .label] | @tsv' \
            "$claude_json" 2>/dev/null | grep -vE $'^(opus|sonnet|haiku)\t' || true)}")
    fi
    local row fam rank
    for row in "${rows[@]}"; do
        [[ -n "$row" ]] || continue
        rank=$(( ${#families} + 1 ))
        for fam in "${families[@]}"; do
            [[ "${row%%$'\t'*}" == *"$fam"* ]] && { rank=${families[(i)$fam]}; break; }
        done
        print -r -- "$rank"$'\t'"$row"
    done | sort -t$'\t' -k1,1n -s | cut -f2-
}

# A program cannot change its parent shell's folder, so the shell function
# printed here runs clo, then cds to the folder the session was launched in.
init_zsh() {
    cat <<'EOF'
clo() {
    local f rc d
    f="$(mktemp "${TMPDIR:-/tmp}/clo.XXXXXX")" || return
    CLO_CD_FILE="$f" command clo "$@"
    rc=$?
    d="$(cat -- "$f" 2>/dev/null)"
    command rm -f -- "$f"
    [[ -n "$d" && -d "$d" && "$d" != "$PWD" ]] && cd -- "$d"
    return $rc
}
EOF
}

case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    --list)    menu | cut -f2; exit 0 ;;
    --init)    [[ "${2:-}" == zsh ]] || { print -u2 "clo: --init supports zsh only"; exit 1; }
               init_zsh; exit 0 ;;
esac

zmodload -F zsh/stat b:zstat
zmodload zsh/datetime
projects_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects"
now=$EPOCHSECONDS

# last_session <dir> — print when Claude Code last wrote a session for <dir>
# (epoch seconds), or nothing. Its per-folder directory name is the real path
# with every character other than a letter or digit turned into "-".
last_session() {
    local f
    f="$(last_session_file "$1")" && zstat +mtime -- "$f"
}

# last_session_file <dir> — the newest session file for <dir>, or fail
last_session_file() {
    local -a f=("$projects_dir/${${1:A}//[^A-Za-z0-9]/-}"/*.jsonl(N.om[1]))
    (( $#f )) && print -r -- "$f[1]"
}

# ago <epoch> — "now", "5m", "3h", "12d", "4mo"
ago() {
    local s=$(( now - $1 ))
    if   (( s < 60 ));      then print -r -- now
    elif (( s < 3600 ));    then print -r -- "$(( s / 60 ))m"
    elif (( s < 86400 ));   then print -r -- "$(( s / 3600 ))h"
    elif (( s < 2592000 )); then print -r -- "$(( s / 86400 ))d"
    else                         print -r -- "$(( s / 2592000 ))mo"
    fi
}

# path <TAB> dimmed age + tags <TAB> name, for every folder local-repos-list reports,
# after rows for the dev root itself and the current folder. Falls back to the dev root's
# immediate subfolders, untagged, when local-repos-list is not installed.
folder_menu() {
    local dim=$'\e[2m' off=$'\e[0m' here="${PWD/#$HOME/~}"
    local -a names paths tags
    local name dir tag i
    if command -v local-repos-list >/dev/null && command -v jq >/dev/null; then
        while IFS=$'\t' read -r name dir tag; do
            names+=("$name") paths+=("$dir") tags+=("$tag")
        done < <(local-repos-list --root "$DEV_ROOT" --json 2>/dev/null \
            | jq -r 'sort_by(.name | ascii_downcase)[] | [.name, .path, (.tags | join(" "))] | @tsv')
    else
        for dir in "$DEV_ROOT"/*(N/); do
            names+=("${dir:t}") paths+=("$dir") tags+=("")
        done
    fi
    # Folders with a Claude session come first, most recent on top; the rest
    # keep alphabetical order. The dev root and the current folder always lead.
    local -a when order
    for (( i = 1; i <= $#names; i++ )); do when[$i]="$(last_session "${paths[$i]}")"; done
    order=(${(f)"$(for (( i = 1; i <= $#names; i++ )); do print -r -- "${when[$i]:-0}"$'\t'"$i"; done \
        | sort -t$'\t' -k1,1nr -k2,2n | cut -f2)"})
    # Age and tags go first, padded to one width, so every name starts in the
    # same column however long it is; fzf searches only the last field, the name.
    local tw=${#${DEV_ROOT/#$HOME/~}} t
    for tag in "${tags[@]}"; do (( ${#tag} > tw )) && tw=${#tag}; done
    row() {
        t="$(last_session "$1")"; [[ -n "$t" ]] && t="$(ago "$t")"
        printf '%s\t%s%-4s %-*s%s  \t%s\n' "$1" "$dim" "$t" "$tw" "$3" "$off" "$2"
    }
    row search "search history" ""
    row "$DEV_ROOT" "${DEV_ROOT:t}" "${DEV_ROOT/#$HOME/~}"
    row "$PWD" "$here" ""
    for i in "${order[@]}"; do row "${paths[$i]}" "${names[$i]}" "${tags[$i]}"; done
}

effort_rows=($'unset\tunset' $'low\tlow' $'medium\tmedium' $'high\thigh' $'xhigh\txhigh' $'max\tmax')
effort_state() { print -r -- "$state_dir/effort/${1//[^A-Za-z0-9._-]/_}"; }

# session_rows <dir> — <dir>'s sessions, newest first, as rows whose value is
# resume:<session id>. They come from the cc-statusline snapshot clo takes at
# start ($CLO_SNAPSHOT), the same list Agent Bar Hopping shows: its topic, the
# model and effort, and "live" for one still running in another terminal.
session_rows() {
    [[ -r "${CLO_SNAPSHOT:-}" ]] || return 0
    local want="${${1:A}/#$HOME/~}" id at topic setup live i w=0
    local dim=$'\e[2m' off=$'\e[0m'
    local -a ids ats topics setups lives
    # Fields are split on \x1f, not a tab: a tab is whitespace to read, and
    # empty fields would collapse.
    while IFS=$'\x1f' read -r id at topic setup live; do
        ids+=("$id") ats+=("$at") topics+=("$topic") setups+=("$setup") lives+=("$live")
        (( ${#topic} > w && ${#topic} <= 48 )) && w=${#topic}
    done < <(jq -r --arg d "$want" '
        [(.live[]? | . + {is_live: true}), (.history[]? | . + {is_live: false})]
        | map(select(.summary.cwd == $d and .summary.session_id != null))
        | sort_by(-(.active_at // .updated_at // 0))[]
        | [.summary.session_id,
           ((.active_at // .updated_at // 0) / 1000 | floor | tostring),
           (.summary.topic // .summary.session_name // "untitled"),
           ([.summary.model_full, .summary.effort] | map(select(. != null and . != "")) | join(" · ")),
           (if .is_live then "live" else "" end)]
        | join("\u001f")' "$CLO_SNAPSHOT" 2>/dev/null)
    for (( i = 1; i <= $#ids; i++ )); do
        printf 'resume:%s\t%s%-4s%s %-*s  %s%s%s\n' "${ids[$i]}" "$dim" "$(ago "${ats[$i]}")" "$off" \
            "$w" "${topics[$i]}" "$dim" "${setups[$i]}${lives[$i]:+  ${lives[$i]}}" "$off"
    done
}

# start_rows <dir> — the model menu for <dir>: every model (each starts a new
# session), then <dir>'s sessions, then Claude Code's own session picker for
# anything older.
start_rows() {
    local sessions pad="" r
    sessions="$(session_rows "$1")"
    # Session rows lead with an age column; the others leave it empty, so every
    # name starts in the same column.
    [[ -n "$sessions" ]] && pad="     "
    # Search is offered in the first menu only; after a folder menu it is gone.
    [[ "$(run_get ask_folder)" == 1 ]] || print -r -- "search"$'\t'"${pad}search history"
    for r in "${(@f)$(menu)}"; do print -r -- "${r%%$'\t'*}"$'\t'"$pad${r#*$'\t'}"; done
    [[ -n "$sessions" ]] && print -r -- "$sessions"
    last_session_file "$1" >/dev/null || return 0
    print -r -- "resume"$'\t'"${pad}resume a session"
}

# label <value> <value<TAB>label>... — the label shown for <value>
label() {
    local v="$1" r; shift
    for r in "$@"; do [[ "${r%%$'\t'*}" == "$v" ]] && { print -r -- "${r#*$'\t'}"; return; }; done
    print -r -- "$v"
}

# section <title> <state file> <first-run value> <rows>... — a menu as text,
# for the side pane: the row it would open on marked, "latest" as in mark_rows().
section() {
    local title="$1" state="$2" last="$3" saved="" r v mark=$'  \e[2mlatest\e[0m'; shift 3
    [[ -n "$state" && -r "$state" ]] && saved="$(<"$state")" && last="$saved"
    [[ -n "$last" ]] || last="${1%%$'\t'*}"
    print -r -- $'\e[2m'"$title"$'\e[0m'
    for r in "$@"; do
        v="${r%%$'\t'*}"
        if [[ "$v" == "$last" ]]; then
            print -r -- "› ${r#*$'\t'}${saved:+$mark}"
        else
            print -r -- "  ${r#*$'\t'}"
        fi
    done
    [[ "$title" == effort* ]] || print
}

# session_detail <session id> — the side pane for one session: its topic and
# Claude Code's own name for it, model and effort, and whether it still runs.
session_detail() {
    jq -r --arg id "$1" '
        [(.live[]? | . + {is_live: true}), (.history[]? | . + {is_live: false})]
        | map(select(.summary.session_id == $id))[0] // empty
        | "\u001b[2msession\u001b[0m",
          "  " + (.summary.topic // "untitled"),
          (if .summary.session_name then "  \u001b[2m" + .summary.session_name + "\u001b[0m" else empty end),
          "",
          "\u001b[2mmodel, effort\u001b[0m",
          "  " + ([.summary.model_full, .summary.effort] | map(select(. != null)) | join(" · ")),
          "",
          "\u001b[2mstate\u001b[0m",
          "  " + (if .is_live then "live in another terminal" else "ended" end),
          ""' "$CLO_SNAPSHOT" 2>/dev/null || true
}

# The command a launch would run, as text.
launch_line() {
    local dir="$1" session="$2" model="$3" effort="$4" cmd=claude
    case "$session" in
        resume)   cmd+=" --resume" ;;
        resume:*) cmd+=" --resume ${session#resume:}" ;;
        *)        cmd+=" --model $model"; [[ "$effort" == unset ]] || cmd+=" --effort $effort" ;;
    esac
    print -r -- $'\e[2m'"launches"$'\e[0m'
    print -r -- "$cmd"
    print -r -- $'\e[2m'"in ${dir/#$HOME/~}"$'\e[0m'
}

# ── Search history ────────────────────────────────────────────────────────────
# search-history.py writes the hits of a search to $CLO_RUN/search.json; its
# stderr, an invalid regex say, to search.err. Topics, model and effort come
# from the cc-statusline snapshot where it knows the session, else from the
# transcript's own title, else from its first typed prompt.

search_py="${self:h}/search-history.py"

# The jq that indexes the snapshot's sessions by id, as $known.
known_jq='(($snap[0] // {}) as $s
    | [(($s.live // [])[] | .summary + {is_live: true}), (($s.history // [])[] | .summary + {is_live: false})]
    | map(select(.session_id != null) | {key: .session_id, value: .}) | from_entries) as $known'

# search_run <term> — run the search, then print its rows. It runs on every
# keystroke; fzf drops a reload the next keystroke replaces, but the search
# itself may still finish, so only the latest term's results are kept.
search_run() {
    local out="$CLO_RUN/search.json" tmp="$CLO_RUN/search.$$"
    run_set term "$1"
    run_set pos 1
    if [[ -z "$1" ]]; then
        rm -f -- "$out" "$CLO_RUN/search.err"
        return 0
    fi
    if "$search_py" --json --limit 50 -- "$1" > "$tmp.json" 2> "$tmp.err"; then
        [[ "$(run_get term)" == "$1" ]] && mv -- "$tmp.json" "$out" && rm -f -- "$CLO_RUN/search.err"
    else
        [[ "$(run_get term)" == "$1" ]] && mv -- "$tmp.err" "$CLO_RUN/search.err" && rm -f -- "$out"
    fi
    rm -f -- "$tmp.json" "$tmp.err"
    [[ "$(run_get term)" == "$1" ]] && search_rows
    return 0
}

# search_rows — the hits, most recently active first, as rows whose value is
# hit:<session id>: age, folder, topic, hit count.
search_rows() {
    [[ -s "$CLO_RUN/search.json" ]] || return 0
    local dim=$'\e[2m' off=$'\e[0m' id at cwd topic n i fw=0 folder
    local -a ids ats folders topics ns
    while IFS=$'\x1f' read -r id at cwd topic n; do
        folder="${cwd:t}"; [[ "$cwd" == "$HOME" ]] && folder="~"
        (( ${#topic} > 60 )) && topic="${topic[1,59]}…"
        ids+=("$id") ats+=("$at") folders+=("$folder") topics+=("$topic") ns+=("$n")
        (( ${#folder} > fw )) && fw=${#folder}
    done < <(jq -r --slurpfile snap "$CLO_SNAPSHOT" "$known_jq"'
        | .results[]
        | [.session_id,
           ((.last // .started // "") | sub("\\.[0-9]+"; "") | try fromdateiso8601 catch 0 | tostring),
           (.cwd // "?"),
           ($known[.session_id].topic // .title // .preview // "untitled" | gsub("[\t\n\u001f]"; " ")),
           (.match_count | tostring)]
        | join("\u001f")' "$CLO_RUN/search.json" 2>/dev/null)
    (( fw > 24 )) && fw=24
    for (( i = 1; i <= $#ids; i++ )); do
        printf 'hit:%s\t%s%-4s%s %-*s  %s  %s%s%s\n' "${ids[$i]}" "$dim" "$(ago "${ats[$i]}")" "$off" \
            "$fw" "${folders[$i][1,$fw]}" "${topics[$i]}" "$dim" "${ns[$i]} $( (( ns[$i] == 1 )) && print hit || print hits)" "$off"
    done
}

# search_header — the search step's header: what to do, or what the search found.
search_header() {
    local term="$(run_get term)" n
    if [[ -z "$term" ]]; then
        print -r -- "type to search every session · a term with . * ( [ | and the like is a regex"
    elif [[ -s "$CLO_RUN/search.err" ]]; then
        print -r -- "“$term”: $(tail -n 1 "$CLO_RUN/search.err")"
    elif [[ ! -s "$CLO_RUN/search.json" ]]; then
        print -r -- "“$term”: the search failed"
    else
        n="$(jq -r '.total' "$CLO_RUN/search.json")"
        case "$n" in
            0) print -r -- "no session mentions “$term”" ;;
            1) print -r -- "1 session mentions “$term” · Enter reopens it" ;;
            *) print -r -- "$n sessions mention “$term”$( (( n > 50 )) && print " · newest 50 shown") · Enter reopens one" ;;
        esac
    fi
}

# search_detail <session id> — the side pane for one hit: the session, then
# every match with the term highlighted.
search_detail() {
    jq -r --arg id "$1" --arg home "$HOME" --slurpfile snap "$CLO_SNAPSHOT" "$known_jq"'
        | .results[] | select(.session_id == $id)
        | $known[.session_id] as $k
        | "\u001b[1m" + ($k.topic // .title // .preview // "untitled") + "\u001b[0m",
          "\u001b[2m" + ((.cwd // "?") | if startswith($home) then "~" + .[($home | length):] else . end)
              + (if .branch then " · " + .branch else "" end) + "\u001b[0m",
          "\u001b[2m" + ([($k.model_full // null), ($k.effort // null),
                          (if $k == null then null elif $k.is_live then "live in another terminal" else "ended" end),
                          ((.last // "") | sub("\\.[0-9]+"; "") | try (fromdateiso8601 | localtime | strftime("%b %d %H:%M")) catch null)]
                         | map(select(. != null and . != "")) | join(" · ")) + "\u001b[0m",
          "\u001b[2m" + (.match_count | tostring) + (if .match_count == 1 then " match" else " matches" end)
              + (if .match_count > (.snippets | length) then ", first \(.snippets | length) shown" else "" end) + "\u001b[0m",
          "",
          (.snippets[] | "\u001b[2m" + (if .role == "user" then "you" else "claude" end) + "\u001b[0m",
                         .before + "\u001b[1;33m" + .match + "\u001b[0m" + .after,
                         "")' "$CLO_RUN/search.json" 2>/dev/null || true
}

# ── One fzf for the whole run ─────────────────────────────────────────────────
# Every menu shows in the same fzf, so moving between them never leaves the
# screen: Enter and Esc run clo again (the handlers below), which record the
# pick in $CLO_RUN and tell fzf which prompt, header and rows come next.
# Separate fzf runs would each swap the terminal's screen in and out: a flicker.
#
# $CLO_RUN holds: step (folder, model or effort), history (the steps shown, in
# order), start (the folder clo was run from), dir, choice (a model, resume or
# resume:<id>), effort, pos (the row the current menu opens on), done, and
# snapshot and folder.rows (built once).

run_get() { cat -- "$CLO_RUN/$1" 2>/dev/null || true; }
run_set() { print -r -- "$2" > "$CLO_RUN/$1"; }

# mark_rows <state file> <first-run value> <value<TAB>label>... — print the rows
# with the remembered one marked "latest", and record the row the menu opens on:
# the value saved in <state file>, else <first-run value>, else the first row.
mark_rows() {
    local state="$1" last="$2" saved="" i pos=1; shift 2
    [[ -n "$state" && -r "$state" ]] && saved="$(<"$state")" && last="$saved"
    local -a rows=("$@")
    for (( i = 1; i <= $#rows; i++ )); do
        [[ "${rows[$i]%%$'\t'*}" == "$last" ]] || continue
        pos=$i
        [[ -n "$saved" ]] && rows[$i]+=$'  \e[2mlatest\e[0m'
        break
    done
    run_set pos "$pos"
    print -rl -- "${rows[@]}"
}

# The rows of the current menu.
current_rows() {
    local dir
    case "$(run_get step)" in
        folder) [[ -s "$CLO_RUN/folder.rows" ]] || folder_menu > "$CLO_RUN/folder.rows"
                mark_rows "" "$(run_get start)" "${(@f)$(<"$CLO_RUN/folder.rows")}" ;;
        model)  dir="$(run_get dir)"
                mark_rows "$state_dir/last" "" "${(@f)$(start_rows "$dir")}" ;;
        effort) mark_rows "$(effort_state "$(run_get choice)")" unset "${effort_rows[@]}" ;;
        search) run_set pos 1; search_rows ;;
    esac
}

# The current menu's prompt, e.g. "choose a model > "
prompt_text() {
    case "$(run_get step)" in
        folder) print -r -- "choose a folder > " ;;
        model)  print -r -- "choose a model > " ;;
        effort) print -r -- "choose an effort level > " ;;
        search) print -r -- "search history > " ;;
    esac
}

# The current menu's header: the picks so far, e.g. "~/dev/oj › Opus"
header_text() {
    local step="$(run_get step)"
    [[ "$step" == search ]] && { search_header "$@"; return; }
    local -a c=()
    [[ "$step" != folder && "$(run_get ask_folder)" == 1 ]] && c+=("${$(run_get dir)/#$HOME/~}")
    [[ "$step" == effort ]] && c+=("$(label "$(run_get choice)" "${(@f)$(menu)}")")
    print -r -- "${(j: › :)c}"
}

# The fzf actions that show the current menu. change-header: takes the rest of
# the line, so it goes last. The search step types a term rather than filtering
# rows, and wants a wider, wrapping side pane for the matches.
show_actions() {
    local mode="enable-search+change-ghost()+change-preview-window(40%,nowrap)"
    [[ "$(run_get step)" == search ]] \
        && mode="disable-search+change-ghost(type to search every session)+change-preview-window(60%,wrap)"
    print -r -- "change-prompt($(prompt_text))+clear-query+$mode+reload(${(q)self} --rows)+change-header:$(header_text)"
}

# Enter in the search step reopens the hit under the cursor, in the session's
# own folder.
search_next() {
    local v="$1" id cwd
    [[ "$v" == hit:* ]] || return 0
    id="${v#hit:}"
    cwd="$(jq -r --arg id "$id" '.results[] | select(.session_id == $id) | .cwd // empty' "$CLO_RUN/search.json")"
    if [[ -z "$cwd" || ! -d "$cwd" ]]; then
        print -r -- "change-header:that session's folder ${cwd:-(unknown)} no longer exists"
        return
    fi
    run_set dir "$cwd"; run_set choice "resume:$id"; run_set done 1
    print -r -- accept
}

# Enter: record the pick, then show the next menu, or finish.
handle_next() {
    local v="${1%$'\t'}" step="$(run_get step)"
    [[ "$step" == search ]] && { search_next "$v"; return; }
    [[ -n "$v" ]] || return 0
    print -r -- "$step" >> "$CLO_RUN/history"
    if [[ "$v" == search ]]; then
        run_set step search; run_set term ""; rm -f -- "$CLO_RUN/search.json" "$CLO_RUN/search.err"
        show_actions; return
    fi
    case "$step" in
        folder) run_set dir "$v"; run_set step model ;;
        model)  run_set choice "$v"
                # resume reopens a session; it is not a model to remember, and
                # the session already has its effort.
                if [[ "$v" == resume* ]]; then run_set done 1; print -r -- accept; return; fi
                mkdir -p "$state_dir"; print -r -- "$v" > "$state_dir/last"
                run_set step effort ;;
        effort) run_set effort "$v"
                # Effort is remembered per model: medium on Opus and xhigh on Fable each stick.
                mkdir -p "$state_dir/effort"; print -r -- "$v" > "$(effort_state "$(run_get choice)")"
                run_set done 1; print -r -- accept; return ;;
    esac
    show_actions
}

# Esc: show the previous menu, or quit from the first.
handle_back() {
    local -a h=("${(@f)$(run_get history)}")
    h=(${h:#})
    (( $#h )) || { print -r -- abort; return; }
    run_set step "${h[-1]}"
    print -rl -- "${h[1,-2][@]}" > "$CLO_RUN/history"
    show_actions
}

# The side pane: the menus still to come if the row under the cursor were picked.
handle_preview() {
    local v="${1%$'\t'}" step="$(run_get step)" dir="$(run_get dir)" model
    if [[ "$step" == search ]]; then
        [[ "$v" == hit:* ]] && search_detail "${v#hit:}"
        return 0
    fi
    if [[ "$v" == search ]]; then
        print -r -- $'\e[2m'"search history"$'\e[0m'
        print -r -- "  every past session, in every folder"
        print -r -- "  Enter on a hit reopens it in its own folder"
        return 0
    fi
    model="$(run_get choice)"
    [[ -n "$model" && "$model" != resume* ]] || model="$(cat "$state_dir/last" 2>/dev/null || true)"
    [[ -n "$model" ]] || model="${${(f)"$(menu)"}[1]%%$'\t'*}"
    case "$step" in
        folder) dir="$v"
                section model "$state_dir/last" "" "${(@f)$(start_rows "$dir")}" ;;
        model)  if [[ "$v" == resume ]]; then
                    print -r -- $'\e[2m'"model, effort"$'\e[0m'; print -r -- "  kept from the session"; print
                    launch_line "$dir" "$v" "" ""; return
                fi
                if [[ "$v" == resume:* ]]; then
                    session_detail "${v#resume:}"
                    launch_line "$dir" "$v" "" ""; return
                fi
                model="$v" ;;
        effort) launch_line "$dir" new "$model" "$v"; return ;;
    esac
    section "effort level · $(label "$model" "${(@f)$(menu)}")" "$(effort_state "$model")" unset "${effort_rows[@]}"
}

# The handlers fzf runs; they find the run through $CLO_RUN.
case "${1:-}" in
    --rows)    current_rows; exit 0 ;;
    --pos)     # The search step's header reports what the search found, once it has.
               if [[ "$(run_get step)" == search ]]; then
                   print -r -- "pos($(run_get pos))+change-header:$(search_header)"
               else
                   print -r -- "pos($(run_get pos))"
               fi
               exit 0 ;;
    --search-run) search_run "${2:-}"; exit 0 ;;
    # Typing filters a menu, but in the search step it searches.
    --change)  if [[ "$(run_get step)" == search ]]; then
                   print -r -- "reload(${(q)self} --search-run ${(q)2:-})"
               else
                   print -r -- first
               fi
               exit 0 ;;
    --next)    handle_next "${2:-}"; exit 0 ;;
    --back)    handle_back; exit 0 ;;
    --preview) handle_preview "${2:-}"; exit 0 ;;
esac

command -v fzf >/dev/null || { print -u2 "clo: fzf is not on PATH"; exit 1; }
command -v claude >/dev/null || { print -u2 "clo: claude is not on PATH"; exit 1; }

CLO_RUN="$(mktemp -d "${TMPDIR:-/tmp}/clo.XXXXXX")"
export CLO_RUN CLO_SNAPSHOT="$CLO_RUN/snapshot"
trap 'rm -rf -- "$CLO_RUN"' EXIT

# One snapshot of every session cc-statusline knows, taken now and read by the
# menus and the side pane. It is the command Agent Bar Hopping itself runs.
# Without node or a cc-statusline checkout, the menus just list no sessions.
statusline="${DEV_ROOT:-${self:h:h:h}}/cc-statusline/cc-statusline.js"
: > "$CLO_SNAPSHOT"
if [[ -r "$statusline" ]] && command -v node >/dev/null; then
    node "$statusline" live > "$CLO_SNAPSHOT" 2>/dev/null || : > "$CLO_SNAPSHOT"
fi

# The menus: folder (outside the dev root only), model (a model, or a session to
# resume), effort (new sessions only). Esc steps back to the previous menu, and
# quits from the first; Ctrl-C quits from any.
run_set start "$PWD"
run_set ask_folder 0
if [[ -n "${DEV_ROOT:-}" && -d "$DEV_ROOT" ]]; then
    dev="${DEV_ROOT:A}"
    [[ "${PWD:A}" != "$dev" && "${PWD:A}" != "$dev"/* ]] && run_set ask_folder 1
fi
if [[ "$(run_get ask_folder)" == 1 ]]; then
    run_set step folder
else
    run_set step model; run_set dir "$PWD"
fi

current_rows | fzf --ansi --delimiter=$'\t' --with-nth=2.. --nth=-1 --reverse --cycle --info=hidden \
    --prompt="$(prompt_text)" --header="$(header_text)" \
    --bind="load:transform(${(q)self} --pos)" \
    --bind="change:transform(${(q)self} --change {q})" \
    --bind="enter:transform(${(q)self} --next {1})" \
    --bind="right:transform(${(q)self} --next {1})" \
    --bind="esc:transform(${(q)self} --back)" \
    --bind="left:transform(${(q)self} --back)" \
    --preview="${(q)self} --preview {1}" \
    --preview-window='right,40%,border-left,<30(hidden)' >/dev/null || true
[[ "$(run_get done)" == 1 ]] || exit 130

dir="$(run_get dir)" choice="$(run_get choice)" effort="$(run_get effort)"
cd "$dir"
case "$choice" in
    resume)   launch=(--resume) ;;
    resume:*) launch=(--resume "${choice#resume:}") ;;
    *)        launch=(--model "$choice")
              [[ "$effort" != unset ]] && launch+=(--effort "$effort") ;;
esac
# Tell the shell function (clo --init zsh) where to leave the terminal.
[[ -n "${CLO_CD_FILE:-}" ]] && print -r -- "$PWD" > "$CLO_CD_FILE"
rm -rf -- "$CLO_RUN"   # exec skips the EXIT trap
exec claude "${launch[@]}" "$@"
