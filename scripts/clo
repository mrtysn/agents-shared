#!/bin/zsh
# DESC: Pick a Claude model and effort from a menu and launch Claude Code with them; menus open on your last pick
set -euo pipefail

usage() {
    cat <<'EOF'
clo — pick a Claude model and effort level, then launch Claude Code with them.

Usage:
  clo [claude args...]    Open the picker; extra args go to `claude` (e.g. clo -c)
  clo --list              Print the menu entries and exit
  clo -h | --help         Show this help

The picks apply to that session only (claude --model --effort); your saved
defaults in settings.json are untouched. The model menu opens on your last
model, and the effort menu on the effort you last used with that model.
"unset" passes no --effort, so Claude Code's own default applies.

The menu is the stable aliases (always the latest of each family) plus any
extra models your account is offered, read from Claude Code's own cache in
.claude.json. Claude Code has no command that prints the picker's list.
EOF
}

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/clo"
claude_json="${CLAUDE_CONFIG_DIR:-$HOME}/.claude.json"

# Model families, most capable first. An extra from the cache whose family is
# not listed here goes last.
families=(fable opus sonnet haiku)

# value <TAB> label, most capable first
menu() {
    local -a rows=($'opus\tOpus' $'sonnet\tSonnet' $'haiku\tHaiku')
    if [[ -r "$claude_json" ]] && command -v jq >/dev/null; then
        rows+=("${(@f)$(jq -r '.additionalModelOptionsCache[]? | [.value, .label] | @tsv' \
            "$claude_json" 2>/dev/null | grep -vE $'^(opus|sonnet|haiku)\t' || true)}")
    fi
    local row fam rank
    for row in "${rows[@]}"; do
        [[ -n "$row" ]] || continue
        rank=$(( ${#families} + 1 ))
        for fam in "${families[@]}"; do
            [[ "${row%%$'\t'*}" == *"$fam"* ]] && { rank=${families[(i)$fam]}; break; }
        done
        print -r -- "$rank"$'\t'"$row"
    done | sort -t$'\t' -k1,1n -s | cut -f2-
}

case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    --list)    menu | cut -f2; exit 0 ;;
esac

command -v fzf >/dev/null || { print -u2 "clo: fzf is not on PATH"; exit 1; }
command -v claude >/dev/null || { print -u2 "clo: claude is not on PATH"; exit 1; }

# pick <prompt> <state file> <first-run value> <value<TAB>label>... — print the
# chosen value. The menu opens on the value saved in <state file>, else on
# <first-run value>, else on the first entry.
pick() {
    local prompt="$1" state="$2" last="$3"; shift 3
    local pos=1 i choice saved=""
    [[ -r "$state" ]] && saved="$(<"$state")" && last="$saved"
    local -a rows=("$@")
    for i in {1..$#rows}; do
        [[ "${rows[$i]%%$'\t'*}" == "$last" ]] || continue
        pos=$i
        [[ -n "$saved" ]] && rows[$i]+="  (latest)"
        break
    done
    set -- "${rows[@]}"
    choice="$(print -rl -- "$@" \
        | fzf --delimiter=$'\t' --with-nth=2 --height=~50% --reverse --info=hidden \
              --no-sort --prompt="$prompt> " --bind="load:pos($pos)")" || return 130
    choice="${choice%%$'\t'*}"
    mkdir -p "${state:h}"
    print -r -- "$choice" > "$state"
    print -r -- "$choice"
}

model="$(pick model "$state_dir/last" "" "${(@f)$(menu)}")" || exit 130
# Effort is remembered per model: medium on Opus and xhigh on Fable each stick.
effort="$(pick effort "$state_dir/effort/${model//[^A-Za-z0-9._-]/_}" unset \
    $'unset\tunset' $'low\tlow' $'medium\tmedium' $'high\thigh' $'xhigh\txhigh' $'max\tmax')" \
    || exit 130

if [[ "$effort" == unset ]]; then
    exec claude --model "$model" "$@"
fi
exec claude --model "$model" --effort "$effort" "$@"
